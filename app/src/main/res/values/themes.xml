<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MiEsport" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background_black</item>
        <item name="android:navigationBarColor">@color/background_black</item>
        <item name="android:windowBackground">@color/background_black</item>
    </style>

    <style name="Theme.MiEsport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MiEsport</item>
    </style>
</resources>
