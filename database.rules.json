{
  "rules": {
    "live_status": {
      ".read": true,
      "$tournamentId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "room_reveal": {
      "$tournamentId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "presence": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
